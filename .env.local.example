# Neon Database (any non-Neon URL uses node-postgres, e.g. local Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Public URL of the app (OAuth issuer + MCP resource). No trailing slash.
APP_URL=https://olympus.example.com
# Fallback timezone for an athlete whose browser hasn't reported one yet.
# Each athlete's own timezone lives in their profile (Settings › Your training).
APP_TIMEZONE=UTC

# --- Access ------------------------------------------------------------------
# Google accounts allowed to sign in and connect Claude (comma-separated). Set
# this in production; if unset, anyone with a Google account can sign up (each
# still sees only their own data).
ALLOWED_EMAILS=you@gmail.com,friend@gmail.com
# Who may edit the shared exercise library (machine carriage weights).
# Defaults to everyone on ALLOWED_EMAILS; set it to just you when sharing.
OWNER_EMAILS=you@gmail.com

# --- LiftLog MCP ------------------------------------------------------------
# Extra OAuth redirect hosts beyond claude.ai / claude.com / loopback (rarely needed).
OAUTH_REDIRECT_HOSTS=
# Optional static bearer key for Claude Code / Desktop configs that send a
# header instead of doing OAuth. 32+ chars: openssl rand -hex 32
MCP_API_KEY=
MCP_API_KEY_USER=you@gmail.com

# --- Web push ("plan's ready") -----------------------------------------------
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@gmail.com

# --- Whoop (sleep) — https://developer.whoop.com ---------------------------------
# Redirect URI to register: <APP_URL>/api/integrations/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
